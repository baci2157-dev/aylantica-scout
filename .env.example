# ── Scout: переменные окружения ───────────────────────────────────
# Скопируйте: cp .env.example .env  — и заполните значения.
# Без TELEGRAM_* сервис поднимется, но /scan ответит 503 (нет клиента).
# Без ZAI_API_KEY классификация уйдёт на эвристику (хуже, но работает).

# Telegram-аккаунт разведчика (my.telegram.org → API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# StringSession аккаунта-разведчика: python -m scout.session_login
TELEGRAM_SESSION=

# ZAI (GLM) — классификация лидов и полировка черновиков
ZAI_API_KEY=
ZAI_MODEL=glm-4.6
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# Aylantica — куда пушим утверждённых лидов
# (например https://aylantica-fryflow.vercel.app; секрет тот же,
#  что в ENV платформы AYLANTICA_SCOUT_SECRET)
AYLANTICA_API_URL=
AYLANTICA_SCOUT_SECRET=

# Бот-компаньон @aylatica_sales_bot (уведомления владельцу, инбокс бота)
SCOUT_BOT_TOKEN=
OWNER_TELEGRAM_ID=

# Скан
SCAN_WINDOW_H=12            # глубина чтения групп, часов
SCAN_MESSAGES_LIMIT=200     # максимум сообщений на группу за проход
MIN_SCORE=6                 # порог ZAI-скора, ниже — rejected
SCAN_EVERY_H=4              # встроенный cron (0 — только вручную/внешним cron)

# Лимиты отправки (прогрев аккаунта — святое)
DAILY_SEND_LIMIT=8
SEND_INTERVAL_SEC=1800
WARMUP_NO_LINK_DAYS=2
GROUP_COOLDOWN_H=4
USER_COOLDOWN_DAYS=14

# Сервис
PORT=8080
DATA_DIR=./data
